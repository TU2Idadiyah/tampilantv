# ==============================================================================
# STAI SIDOGIRI - SISTEM INFORMASI LAYAR KAMPUS & PORTAL TERPADU
# File Konfigurasi Lingkungan (.env)
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan dengan pengaturan server hosting Anda.

# [APLIKASI & DOMAIN]
APP_NAME="STAI Sidogiri Display & Portal"
APP_ENV=production

# Kosongkan APP_URL untuk deteksi otomatis domain & protokol (HTTP/HTTPS) secara dinamis,
# atau isi lengkap jika ingin memaksakan satu domain (contoh: https://display.stai-sidogiri.ac.id)
APP_URL=

# [KONEKSI DATABASE MYSQL]
# Di cPanel / VPS, sesuaikan DB_HOST, DB_DATABASE, DB_USERNAME, dan DB_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stai_display
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# [KEAMANAN & VALIDASI PRESENSI]
# Set DISABLE_SUBNET_CHECK=true jika server di-hosting di cloud/internet publik
# dan pengurus melakukan scan QR menggunakan koneksi paket data seluler (4G/5G).
DISABLE_SUBNET_CHECK=false

# Kunci enkripsi tanda tangan QR Code
QR_SECRET=stai_sidogiri_secret_key_2026

# Kunci akses otentikasi layar TV Kiosk (dapat dibuat ulang di Panel Admin)
DISPLAY_KEY=KUNCI_DEMO_2026

# [PROFIL KAMPUS BAWAAN]
CAMPUS_NAME="STAI SIDOGIRI"
CAMPUS_CITY="Pasuruan"
CAMPUS_LAT=-7.6453
CAMPUS_LON=112.9075
